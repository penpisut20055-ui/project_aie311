# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง (ห้าม commit ไฟล์ .env)
PORT=3001

# Connection string ของ PostgreSQL (เช่นจาก Neon: postgresql://user:pass@host/db?sslmode=require)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aie312

# API key จาก https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# URL ของหน้าเว็บที่อนุญาตให้เรียก API (คั่นด้วย , ได้หลายอัน)
CORS_ORIGIN=http://localhost:5173
